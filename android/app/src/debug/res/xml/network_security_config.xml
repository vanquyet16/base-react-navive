<?xml version="1.0" encoding="utf-8"?>
<!--
  NETWORK SECURITY CONFIG — MỌI BUILD DEBUG (devDebug, stagingDebug, prodDebug)
  Source set của build type (src/debug) được ưu tiên hơn flavor (src/dev, src/prod) và main,
  nên file này áp dụng cho mọi bản debug:
  - Cho phép HTTP tới Metro bundler (localhost / emulator host) và server dev nội bộ.
  - Tin CA người dùng cài để debug bằng Proxyman/Charles.
  KHÔNG được đóng gói vào bản release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">172.20.20.175</domain>
    </domain-config>
</network-security-config>
