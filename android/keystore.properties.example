# Sao chép thành android/keystore.properties (đã gitignore) hoặc đặt biến môi trường
# RELEASE_STORE_FILE / RELEASE_STORE_PASSWORD / RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD trên CI.
# Tạo keystore:
#   keytool -genkeypair -v -storetype PKCS12 -keystore release.jks -alias release \
#     -keyalg RSA -keysize 4096 -validity 10000
# Đường dẫn tương đối với thư mục android/
storeFile=keystores/release.jks
storePassword=
keyAlias=release
keyPassword=
