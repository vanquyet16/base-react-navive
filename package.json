{
  "name": "BaseReactNative083",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android:dev": "react-native run-android --mode=devDebug --appId=com.basereactnative083.dev",
    "android:staging": "react-native run-android --mode=stagingDebug --appId=com.basereactnative083.staging",
    "android:prod": "react-native run-android --mode=prodDebug",
    "ios:dev": "ENVFILE=.env.dev react-native run-ios",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios",
    "ios:prod": "ENVFILE=.env.prod react-native run-ios --mode Release",
    "apk:dev": "cd android && ./gradlew assembleDevRelease",
    "apk:staging": "cd android && ./gradlew assembleStagingRelease",
    "apk:prod": "cd android && ./gradlew assembleProdRelease",
    "aab:prod": "cd android && ./gradlew bundleProdRelease",
    "archive:ios:dev": "cd ios && ENVFILE=.env.dev xcodebuild -workspace BaseReactNative083.xcworkspace -scheme BaseReactNative083 -configuration Release -destination generic/platform=iOS -archivePath build/dev.xcarchive archive",
    "archive:ios:staging": "cd ios && ENVFILE=.env.staging xcodebuild -workspace BaseReactNative083.xcworkspace -scheme BaseReactNative083 -configuration Release -destination generic/platform=iOS -archivePath build/staging.xcarchive archive",
    "archive:ios:prod": "cd ios && ENVFILE=.env.prod xcodebuild -workspace BaseReactNative083.xcworkspace -scheme BaseReactNative083 -configuration Release -destination generic/platform=iOS -archivePath build/prod.xcarchive archive",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "postinstall": "patch-package",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@ant-design/icons-react-native": "^2.3.2",
    "@ant-design/react-native": "^5.4.3",
    "@d11/react-native-fast-image": "^8.13.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/material-top-tabs": "^7.1.0",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.4.0",
    "@shopify/flash-list": "^1.7.0",
    "@tanstack/react-query": "^5.90.19",
    "axios": "1.17.0",
    "react": "19.2.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.83.1",
    "react-native-blob-util": "^0.24.6",
    "react-native-bootsplash": "^6.2.1",
    "react-native-calendars": "^1.1313.0",
    "react-native-config": "^1.7.2",
    "react-native-device-info": "^15.0.2",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^3.3.3",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-pager-view": "^6.6.1",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.20.0",
    "react-native-svg": "^15.15.1",
    "react-native-swiper": "^1.6.0",
    "react-native-tab-view": "^4.0.5",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "^0.7.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-doctor": "^0.5.1",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
